<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- 与 SectionedTooltips 等旧工程一致的编译条件：第三方要能原样复制 sdk/csharp5 里的文件 -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ItemDetailsClient5</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == '' and '$(PS_GAME_DIR)' != ''">$(PS_GAME_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="未指定游戏目录。请用 -p:GameDir='C:\...\Probably Stolen' 构建，或设置环境变量 PS_GAME_DIR。" />
  </Target>

  <ItemGroup>
    <Compile Include="..\..\sdk\csharp5\ItemDetailsClient5.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
