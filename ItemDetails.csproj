<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ItemDetails</AssemblyName>
    <RootNamespace>ItemDetails</RootNamespace>
    <!-- 游戏根目录：优先 -p:GameDir=...，其次环境变量 PS_GAME_DIR；都没给就在构建时报错 -->
    <GameDir Condition="'$(GameDir)' == '' and '$(PS_GAME_DIR)' != ''">$(PS_GAME_DIR)</GameDir>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <!-- 诊断信息和自检代码默认不进产物；分别用 -p:Diag=true / -p:SelfTest=true 开启 -->
    <Diag Condition="'$(Diag)' == ''">false</Diag>
    <SelfTest Condition="'$(SelfTest)' == ''">false</SelfTest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);ITEMDETAILS_SELFTEST</DefineConstants>
  </PropertyGroup>

  <!-- 自检依赖诊断日志；单独 Diag 只启用信息与性能日志，不启用自动读档/自检。 -->
  <PropertyGroup Condition="'$(SelfTest)' == 'true' Or '$(Diag)' == 'true'">
    <DefineConstants>$(DefineConstants);ITEMDETAILS_DIAG</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="未指定游戏目录。请用 -p:GameDir='C:\...\Probably Stolen' 构建，或设置环境变量 PS_GAME_DIR。" />
    <Error Condition="'$(ManagedDir)' != '' and !Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="在 $(ManagedDir) 没找到 Assembly-CSharp.dll，请确认 GameDir 指向游戏根目录。" />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input 在这个模块里（双击检测需要） -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs;out\**\*.cs;obj\**\*.cs;bin\**\*.cs" />
    <None Update="manifest.xml;Textures\**\*;Sounds\**\*;Localization\**\*;LootTables\**\*;Books\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
